# Copy to .env and adjust. start.sh loads this file; the API also has safe defaults.

# Backend API. Keep 127.0.0.1: host-folder import can read any directory on this machine.
API_HOST=127.0.0.1
API_PORT=3200
# App-owned library: SQLite, originals, derivatives, thumbnails. Relative to the repo root.
DATA_DIR=./data

# Frontend dev server
WEB_PORT=5173

# n8n: "local" = start/stop the Docker container in automation/n8n; "remote" = use N8N_BASE_URL only.
N8N_MODE=local
N8N_BASE_URL=http://localhost:5678
# Production webhook of the enrichment workflow (filled in once the workflow exists).
N8N_WEBHOOK_URL=
# Shared secret sent as X-Album-Secret; must match the workflow's Header Auth credential.
N8N_WEBHOOK_SECRET=

# Local embedding service: Qwen3-VL-Embedding-2B served by vLLM from the project's .venv.
# Setup: uv venv .venv --python 3.12 && uv pip install --python .venv/bin/python vllm==0.30.0
# and download the model into models/Qwen3-VL-Embedding-2B (its REVISION file pins the version).
VLLM_ENABLED=false
VLLM_PORT=8000
VLLM_MODEL=models/Qwen3-VL-Embedding-2B
# Defaults to the REVISION file in VLLM_MODEL.
VLLM_REVISION=
VLLM_GPU_MEMORY_UTILIZATION=0.8
VLLM_MAX_MODEL_LEN=4096
# Image embedding requests in flight; vLLM batches them on the GPU.
VLLM_CONCURRENCY=6

# Import and cleanup
# IMPORT_CONCURRENCY defaults to CPU cores - 1.
IMPORT_CONCURRENCY=
MAX_IMPORT_MB=200
ASSET_GRACE_HOURS=24
