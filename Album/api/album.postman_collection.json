{
  "info": {
    "name": "Album REST API",
    "description": "Album REST API. Every /api request except /api/health needs the X-API-Key header; set apiKey in the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication and monitoring",
      "description": "API key check and the health endpoint used for monitoring.",
      "item": [
        {
          "name": "Health check (no key needed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"all services report ok\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql(\"ok\");",
                  "  pm.expect(b.services).to.have.keys(\"database\", \"n8n\", \"embedding\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Reject request without API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"error code is unauthorized\", () => pm.expect(pm.response.json().error.code).to.eql(\"unauthorized\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/albums",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "albums"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Reject request with wrong API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"error code is unauthorized\", () => pm.expect(pm.response.json().error.code).to.eql(\"unauthorized\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/albums",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "albums"
              ]
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key"
                },
                {
                  "key": "value",
                  "value": "wrong-key"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Albums (full CRUD)",
