      "item": [
        {
          "name": "List albums",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns an items array\", () => pm.expect(pm.response.json().items).to.be.an(\"array\").that.is.not.empty);",
                  "pm.collectionVariables.set(\"libraryAlbumId\", pm.response.json().items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/albums",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "albums"
              ]
            }
          }
        },
        {
          "name": "Create album",
