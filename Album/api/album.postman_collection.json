            "body": {
              "mode": "raw",
              "raw": "{\n  \"manualCaption\": \"Edited during API testing\"\n}"
            }
          }
        },
        {
          "name": "Restore previous description",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/photos/{{photoId}}/description",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "photos",
                "{{photoId}}",
                "description"
              ]
