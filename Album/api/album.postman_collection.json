    {
      "name": "3. Safe retries (Idempotency-Key)",
      "description": "A client that retries a POST after a timeout must not create the album twice.",
      "item": [
        {
          "name": "Create album with Idempotency-Key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = Date.now();",
                  "pm.collectionVariables.set(\"idemKey\", \"api-\" + t);",
                  "pm.collectionVariables.set(\"idemName\", \"API idempotent \" + t);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"idemAlbumId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/albums",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "albums"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{idemName}}\"\n}"
            }
          }
        },
        {
          "name": "Repeat the same request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"first answer is replayed\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));",
                  "pm.test(\"no second album was created\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"idemAlbumId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/albums",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "albums"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{idemName}}\"\n}"
            }
          }
        },
        {
          "name": "Clean up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/albums/{{idemAlbumId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "albums",
                "{{idemAlbumId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Photos and search",
      "description": "Workflows: browse a library, correct a description, find a photo by words or meaning.",
      "item": [
        {
          "name": "List photos in an album (paged)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"at most 5 items, with a total\", () => { pm.expect(b.items.length).to.be.at.most(5); pm.expect(b.total).to.be.a(\"number\"); });",
                  "pm.collectionVariables.set(\"photoId\", b.items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/albums/{{libraryAlbumId}}/photos?offset=0&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "albums",
                "{{libraryAlbumId}}",
                "photos"
              ],
              "query": [
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Get photo detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().description;",
                  "pm.test(\"has an AI description and tags\", () => pm.expect(d).to.include.keys(\"ai\", \"manual\", \"tags\"));",
                  "pm.collectionVariables.set(\"previousManual\", JSON.stringify(d.manual));"
