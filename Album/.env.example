# Copy to .env and fill in the keys. start.sh loads .env. Paths are relative to this folder.

# Backend API. Keep 127.0.0.1: host-folder import can read any directory on this machine.
API_HOST=127.0.0.1
API_PORT=3200
# Every /api request except /api/health must send this as X-API-Key. The web dev proxy adds it. Empty = no check.
ALBUM_API_KEY=
# App-owned library: SQLite, originals, display copies, thumbnails.
DATA_DIR=./data
# Frontend dev server
WEB_PORT=5173

# n8n (runs from ../n8n). Base URL for health checks and n8n/deploy.mjs; its public API key for deploy.mjs.
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# Local embedding service: Qwen3-VL-Embedding-2B served by vLLM.
VLLM_ENABLED=true
VLLM_PORT=8000
VLLM_MODEL=../models/Qwen3-VL-Embedding-2B
VLLM_BIN=../.venv/bin/vllm
VLLM_GPU_MEMORY_UTILIZATION=0.8
VLLM_MAX_MODEL_LEN=4096
VLLM_CONCURRENCY=6

# Import and clean-up. IMPORT_CONCURRENCY defaults to CPU cores - 1.
IMPORT_CONCURRENCY=
MAX_IMPORT_MB=200
ASSET_GRACE_HOURS=24

# Secrets. Also written here when changed on the settings page. Never commit this file.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
N8N_WEBHOOK_SECRET=

# Baserow (runs from ../baserow). Text-only copy of albums, photos and tags, synced every minute.
# Token: Baserow > My settings > Database tokens. Table ids: shown in the table URL.
BASEROW_URL=http://localhost:8085
BASEROW_TOKEN=
BASEROW_TABLE_ALBUMS=
BASEROW_TABLE_PHOTOS=
BASEROW_TABLE_TAGS=
