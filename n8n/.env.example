# n8n settings. start.sh copies this to .env and generates N8N_ENCRYPTION_KEY on first run.
# Back up .env: the encryption key is required to read credentials stored in the n8n volume.

N8N_VERSION=2.40.7
# Host interface for the published port. Keep 127.0.0.1 on the server too; the reverse proxy connects locally.
N8N_BIND=127.0.0.1

N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Toronto
TZ=America/Toronto

# ---- Local stage ----
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=0
# ---- Server stage: replace the block above with ----
# N8N_HOST=n8n.example.com
# N8N_PORT=5678
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.example.com/
# N8N_SECURE_COOKIE=true
# N8N_PROXY_HOPS=1

EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
N8N_DIAGNOSTICS_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# Data Tables default to 200 MiB in total; raise only if needed.
# N8N_DATA_TABLES_MAX_SIZE_BYTES=209715200
